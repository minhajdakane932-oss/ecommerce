<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section>
        <h1>Your Cart</h1>
        <% if (error) { %><div class="alert"><%= error %></div><% } %>
        <% if (!cart.length) { %>
          <p>Your cart is empty. Browse products to add items.</p>
        <% } else { %>
          <form action="/cart/update" method="POST">
            <table class="table">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Price</th>
                  <th>Qty</th>
                  <th>Subtotal</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% cart.forEach((item) => { %>
                  <tr>
                    <td><%= item.name %></td>
                    <td>$<%= parseFloat(item.price).toFixed(2) %></td>
                    <td><input type="number" name="quantity[<%= item.id %>]" value="<%= item.quantity %>" min="0" /></td>
                    <td>$<%= (item.quantity * parseFloat(item.price)).toFixed(2) %></td>
                    <td><button type="button" class="btn btn-secondary remove-item">Remove</button></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
              <p style="font-size:1.2rem;font-weight:700;">Total: $<%= parseFloat(total).toFixed(2) %></p>
              <div class="actions">
                <button type="submit" class="btn btn-secondary">Update Cart</button>
              </div>
            </div>
          </form>
          <form action="/cart/checkout" method="POST" style="margin-top:16px;">
            <button class="btn btn-primary" type="submit">Checkout</button>
          </form>
        <% } %>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
