<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section>
        <h1>Admin Dashboard</h1>
        <p>Manage inventory and keep your catalog fresh.</p>
        <div style="margin-bottom:20px;"><a class="btn btn-primary" href="/admin/products/new">Add Product</a></div>
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Price</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach((product) => { %>
              <tr>
                <td><%= product.name %></td>
                <td>$<%= parseFloat(product.price).toFixed(2) %></td>
                <td><%= new Date(product.created_at).toLocaleDateString() %></td>
                <td class="actions">
                  <a class="btn btn-secondary" href="/products/<%= product.id %>">View</a>
                  <a class="btn btn-secondary" href="/admin/products/<%= product.id %>/edit">Edit</a>
                  <form action="/admin/products/<%= product.id %>/delete" method="POST" style="display:inline;">
                    <button class="btn btn-secondary" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
