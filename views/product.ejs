<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %> - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section style="display:grid;gap:24px;grid-template-columns:1fr 1fr;align-items:center;">
        <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1520975911959-c1932b6b4891?auto=format&fit=crop&w=900&q=80' %>" alt="<%= product.name %>" style="width:100%;border-radius:20px;object-fit:cover;aspect-ratio:4 / 3;" />
        <div>
          <h1><%= product.name %></h1>
          <p style="line-height:1.8;"><%= product.description || 'Every wardrobe deserves a reliable staple. This item combines comfort with a clean look.' %></p>
          <p style="font-size:1.4rem;font-weight:700;margin:16px 0;">$<%= parseFloat(product.price).toFixed(2) %></p>
          <form action="/products/<%= product.id %>/add-to-cart" method="POST">
            <button class="btn btn-primary" type="submit">Add to Cart</button>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
