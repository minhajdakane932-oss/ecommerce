<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Confirmed - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section style="max-width:620px;margin:0 auto;text-align:center;">
        <h1>Thank you for your order!</h1>
        <p>Your order <strong>#<%= orderId %></strong> has been placed successfully.</p>
        <a class="btn btn-primary" href="/">Continue shopping</a>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
