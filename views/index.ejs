<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <div>
          <h1>Discover your next favorite outfit</h1>
          <p>Browse the latest selection of shirts, dresses, jackets, and accessories. Add items to your cart, register or login, and place your order in minutes.</p>
          <div class="hero-actions">
            <a href="#products">Shop now</a>
          </div>
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=80" alt="Clothing collection" style="width:100%;border-radius:20px;" />
        </div>
      </section>

      <section id="products">
        <h2>Featured Clothes</h2>
        <div class="grid">
          <% products.forEach((product) => { %>
            <div class="card">
              <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1520975911959-c1932b6b4891?auto=format&fit=crop&w=900&q=80' %>" alt="<%= product.name %>" />
              <div class="card-body">
                <h3 class="card-title"><%= product.name %></h3>
                <p><%= product.description ? product.description.substring(0, 80) + '...' : 'Classic style for every day.' %></p>
                <div class="card-actions">
                  <span class="card-price">$<%= parseFloat(product.price).toFixed(2) %></span>
                  <a class="btn btn-primary" href="/products/<%= product.id %>">View</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
