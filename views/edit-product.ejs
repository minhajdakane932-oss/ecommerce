<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Product - Clothes Shop</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <div class="brand"><a href="/" style="color:inherit;text-decoration:none;">Clothes Shop</a></div>
          <div>
            <a href="/">Home</a>
            <a href="/cart">Cart (<%= cartCount %>)</a>
            <% if (!user) { %>
              <a href="/login">Login</a>
              <a href="/register">Register</a>
            <% } else { %>
              <% if (user.isAdmin) { %><a href="/admin">Admin</a><% } %>
              <a href="/logout">Logout</a>
            <% } %>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="form-card" style="max-width:640px;margin:0 auto;">
        <h1>Edit Product</h1>
        <% if (error) { %><div class="alert"><%= error %></div><% } %>
        <form action="/admin/products/<%= product.id %>/edit" method="POST">
          <label>Name</label>
          <input type="text" name="name" value="<%= product.name %>" required />
          <label>Description</label>
          <textarea name="description" rows="5"><%= product.description %></textarea>
          <label>Price</label>
          <input type="number" name="price" step="0.01" value="<%= product.price %>" required />
          <label>Image URL</label>
          <input type="url" name="image_url" value="<%= product.image_url %>" />
          <button class="btn btn-primary" type="submit" style="margin-top:16px;">Update Product</button>
        </form>
      </section>
    </main>

    <footer class="footer">
      <p>Simple ecommerce site for clothes. Powered by Node.js, Express, and MySQL.</p>
    </footer>
    <script src="/js/main.js"></script>
  </body>
</html>
